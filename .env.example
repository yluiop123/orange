# Backend（Spring Boot）
# 数据库
DB_PASSWORD=postgres

# JWT 密钥：开发环境可以省略，后端会自动生成临时密钥。
# 生产环境必须挂载固定 PEM，并保证重启后 token 仍然有效。
# 支持 classpath: 或 file: 前缀。
JWT_PRIVATE_KEY=classpath:keys/private_key.pem
JWT_PUBLIC_KEY=classpath:keys/public_key.pem

# CORS / Cookie / 登录限流
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_MINUTES=15

# 操作日志保留天数；过期日志每天凌晨清理
OPERATION_LOG_RETENTION_DAYS=90
OPERATION_LOG_CLEANUP_CRON=0 30 3 * * *

# 接口文档默认关闭；本地需要 Swagger UI / OpenAPI 时设为 true
SPRINGDOC_ENABLED=false

# Frontend（Vite）
# 开发生成 Mock；接真实后端时设为 false
VITE_MOCK_ENABLE=true
VITE_BASE=/
VITE_ROUTE=browserRouter
VITE_BASE_API=/api/v1/
VITE_PROXY_TARGET=http://localhost:8080
