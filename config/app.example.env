# ORANGE shared configuration — example.
#
# Copy this file to `config/app.env` and edit the values for your machine.
# `config/app.env` is gitignored; this example is the committed template.
# Run `node scripts/sync-config.mjs` to generate each stack's local config.
#
# No real secret belongs here. Cesium tokens, production database passwords
# and JWT keys are supplied through the environment or a local app.env.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
APP_ENV=local

# ---------------------------------------------------------------------------
# Ports (one per stack; the generator maps the stack port to APP_PORT)
# ---------------------------------------------------------------------------
SPRING_PORT=8080
GO_PORT=8081
CSHARP_PORT=8082
RUST_PORT=8083
NEST_PORT=3000
FASTAPI_PORT=8000
REACT_PORT=5173
ANGULAR_PORT=4200
VUE_PORT=5174

# ---------------------------------------------------------------------------
# API and frontend behaviour
# ---------------------------------------------------------------------------
API_BASE=/api/v1/
REACT_API_BASE=/api/v1/
VUE_API_BASE=/api/v1/
ANGULAR_API_BASE=/api/v1
REACT_PROXY_TARGET=http://127.0.0.1:8080
VUE_PROXY_TARGET=http://127.0.0.1:8080
REACT_MOCK_ENABLE=true
VUE_MOCK_ENABLE=true
ANGULAR_MOCK_ENABLE=true
# Empty means "use OpenStreetMap"; set a Cesium Ion token locally if needed.
REACT_CESIUM_TOKEN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orange
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# JWT and cookies
# ---------------------------------------------------------------------------
JWT_SECRET=orange-dev-secret-change-me-in-production
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800
JWT_ISSUER=orange
# Spring Boot uses RSA PEM files. Leave empty to use the classpath keys.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# CORS and operation logs
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4200
LOG_RETENTION_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_MINUTES=15
