# .env
VITE_BASE=/
VITE_BASE_API=/api/v1/
# 开发环境 Vite 代理目标（仅 pnpm dev 生效）
VITE_PROXY_TARGET=http://localhost:8080
# VITE_MOCK_ENABLE=false
# 如果不用代理、直连后端，改用下面这行并重启 dev server
# VITE_BASE_API=http://127.0.0.1:8080/api/v1/
# Cesium token stays local: put it in .env.local, never in a tracked file.
# Empty means the Cesium page uses OpenStreetMap.
