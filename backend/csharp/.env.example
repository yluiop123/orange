# Copy to `.env.local` and edit for your machine.
# `.env.local` is gitignored and loaded by DotEnv on startup.
# Real environment variables always win over this file.

APP_PORT=8082

# Database switch: postgres | mysql | mariadb | sqlite
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orange
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# JWT (same rule in all six backends)
# Both RSA keys set -> RS256 (recommended); otherwise JWT_SECRET -> HS256.
# Generate a development pair with OpenSSL into keys/ (see backend/README.md)
# Each value accepts a PEM file path or inline PEM content.
# JWT_PRIVATE_KEY=../../keys/jwt-private.pem
# JWT_PUBLIC_KEY=../../keys/jwt-public.pem
# Shared development default for the HS256 fallback:
JWT_SECRET=orange-dev-secret-change-me-in-production
JWT_ISSUER=orange
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800
# Legacy alias still accepted: ACCESS_TOKEN_EXPIRE_SECONDS / ACCESS_TOKEN_SECONDS

# Refresh cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# CORS and operation logs
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4200
LOG_RETENTION_DAYS=90

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_MINUTES=15
