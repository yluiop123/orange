# HTTP
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orange
DB_USER=postgres
DB_PASSWORD=postgres
# DB_SSL=false

# JWT (change this outside local development)
JWT_SECRET=orange-dev-secret-change-me
# JWT_ACCESS_EXPIRE=900
# JWT_REFRESH_EXPIRE=604800

# CORS: comma-separated exact origins, credentials are always allowed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Refresh cookie
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# Login lockout
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_IP_MAX_ATTEMPTS=20
# LOGIN_LOCK_MINUTES=15

# Operation log retention
# OPERATION_LOG_RETENTION_DAYS=90
