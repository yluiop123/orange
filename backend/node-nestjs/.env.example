# HTTP
PORT=3000

# Database engine: postgres (default) | mysql | mariadb | sqlite
# DB_DRIVER=postgres

# Connection URL. When set it wins over the discrete DB_* values below.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/orange
# DATABASE_URL=mysql://root:root@localhost:3306/orange
# DATABASE_URL=sqlite:./orange.db

# Discrete connection (PostgreSQL defaults; MySQL/MariaDB default to
# localhost:3306/root/root, SQLite to ./orange.db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orange
DB_USER=postgres
DB_PASSWORD=postgres
# DB_SSL=false

# JWT (same rule in all six backends)
# Both RSA keys set -> RS256 (recommended); otherwise JWT_SECRET -> HS256.
# Generate a development pair at the repository root: pnpm run jwt:keys
# Each value accepts a PEM file path or inline PEM content.
# JWT_PRIVATE_KEY=../../keys/jwt-private.pem
# JWT_PUBLIC_KEY=../../keys/jwt-public.pem
# Shared development default for the HS256 fallback:
JWT_SECRET=orange-dev-secret-change-me-in-production
JWT_ISSUER=orange
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# CORS: comma-separated exact origins, credentials are always allowed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Refresh cookie
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=

# Login lockout
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_IP_MAX_ATTEMPTS=20
# LOGIN_LOCK_MINUTES=15

# Operation log retention
# OPERATION_LOG_RETENTION_DAYS=90
