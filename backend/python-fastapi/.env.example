# Copy to .env or export in your shell. Real environment variables win over .env.
# Connection: DATABASE_URL wins over DB_DRIVER + DB_*; the default is PostgreSQL.
# DB_DRIVER=postgres            # postgres | mysql | mariadb | sqlite
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/orange
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orange
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (same rule in all six backends)
# Both RSA keys set -> RS256 (recommended); otherwise JWT_SECRET -> HS256.
# Generate a development pair with OpenSSL into keys/ (see backend/README.md)
# Each value accepts a PEM file path or inline PEM content.
# JWT_PRIVATE_KEY=../../keys/jwt-private.pem
# JWT_PUBLIC_KEY=../../keys/jwt-public.pem
# Shared development default for the HS256 fallback:
JWT_SECRET=orange-dev-secret-change-me-in-production
JWT_ISSUER=orange
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800
# Legacy aliases still accepted: ACCESS_TOKEN_EXPIRE_SECONDS / REFRESH_TOKEN_EXPIRE_SECONDS

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4200
PORT=8000

# Optional
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_IP_MAX_ATTEMPTS=20
# LOGIN_LOCK_MINUTES=15
# OPERATION_LOG_RETENTION_DAYS=90
