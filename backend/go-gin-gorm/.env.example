# Copy to `.env.local` and edit for your machine.
# `.env.local` is gitignored and loaded by `godotenv` on startup.
# Real environment variables always win over this file.

# HTTP
PORT=8081

# Database switch: postgres | mysql | mariadb | sqlite
DB_DRIVER=postgres
# DATABASE_URL wins over the discrete DB_* values.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/orange?sslmode=disable
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=orange
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_TIMEZONE=UTC
# DB_PATH=orange-go.db

# JWT (change JWT_SECRET outside local development)
# Shared development default; every stack uses the same value locally.
JWT_SECRET=orange-dev-secret-change-me-in-production
JWT_ISSUER=orange
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800
# Legacy aliases still accepted: ACCESS_TOKEN_EXPIRE_SECONDS / REFRESH_TOKEN_EXPIRE_SECONDS
# Optional RS256 keys (enables RS256 instead of HS256)
# JWT_PRIVATE_KEY_PATH=
# JWT_PUBLIC_KEY_PATH=

# CORS and refresh cookie
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4200
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_PATH=/api/v1/auth
# COOKIE_DOMAIN=

# Login lockout and operation logs
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_MINUTES=15
OPERATION_LOG_RETENTION_DAYS=90
