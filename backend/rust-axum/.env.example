# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orange

# HMAC secret used for access and refresh tokens. Change in every real deployment.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# HTTP port (docs/PORTING.md reserves 8083 for this stack)
PORT=8083

# Token lifetimes in seconds (access 15 min, refresh 7 days)
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# Refresh cookie options
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=.example.com

# Login lockout: per user, per IP, window/lock length in minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_MINUTES=15

# Operation log retention
OPERATION_LOG_RETENTION_DAYS=90
