# PostgreSQL connection string. `DB_DRIVER` selects the engine and may also be
# inferred from the URL scheme; MariaDB uses the MySQL URL form.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orange
# DB_DRIVER=postgres   # postgres | mysql | mariadb | sqlite

# Instead of DATABASE_URL you can use discrete values; they are assembled into
# a URL and are ignored when DATABASE_URL is set.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=orange
# DB_USER=postgres
# DB_PASSWORD=postgres
# SQLite only: file path used when DB_DRIVER=sqlite and DATABASE_URL is unset
# DB_FILE=./orange.db

# JWT (same rule in all six backends)
# Both RSA keys set -> RS256 (recommended); otherwise JWT_SECRET -> HS256.
# Generate a development pair with OpenSSL into keys/ (see backend/README.md)
# Each value accepts a PEM file path or inline PEM content.
# JWT_PRIVATE_KEY=../../keys/jwt-private.pem
# JWT_PUBLIC_KEY=../../keys/jwt-public.pem
# Shared development default for the HS256 fallback:
JWT_SECRET=orange-dev-secret-change-me-in-production
JWT_ISSUER=orange

# Comma-separated list of browser origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# HTTP port (docs/PORTING.md reserves 8083 for this stack)
PORT=8083

# Token lifetimes in seconds (access 15 min, refresh 7 days)
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# Refresh cookie options
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# COOKIE_DOMAIN=.example.com

# Login lockout: per user, per IP, window/lock length in minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_MINUTES=15

# Operation log retention
OPERATION_LOG_RETENTION_DAYS=90
